    # ==================== Async Helper ====================
    
    _async_timers = None

    def _retry_fetch_avatar(self, studentId, imageUrl):
        """Spaeter nochmal versuchen - mit festem Timer, nicht per singleShot"""
        if self._async_timers is None:
            self._async_timers = []
        timer = QTimer(self)
        timer.setInterval(1000)
        timer.setSingleShot(True)
        keep = []

        def again():
            try:
                self._async_timers.remove(keep)
            except ValueError:
                pass
            self.fetchAvatar(studentId, imageUrl)

        keep.extend([timer, again])
        self._async_timers.append(keep)
        timer.timeout.connect(again)
        timer.start()


    def _async_check(self, thread, result_attr, signal, error_msg='Anfrage fehlgeschlagen'):
        """
        Auf das Ergebnis eines Hintergrundfadens warten.

        Nicht mit QTimer.singleShot: PySide haelt die uebergebene Funktion
        nicht fest, sie verschwindet mitten im Lauf und das Ergebnis kommt
        dann nie an - die Oberflaeche dreht ewig weiter. Darum ein echter
        QTimer, der zusammen mit seinem Rueckruf am Objekt haengt.
        """
        if self._async_timers is None:
            self._async_timers = []

        timer = QTimer(self)
        timer.setInterval(100)
        keep = []

        def done(payload):
            timer.stop()
            try:
                self._async_timers.remove(keep)
            except ValueError:
                pass
            signal.emit(payload)

        def check():
            result = getattr(self, result_attr, None)
            if result:
                done(result)
            elif not thread.is_alive():
                done(json.dumps({'error': error_msg}))

        keep.extend([timer, check, done])
        self._async_timers.append(keep)
        timer.timeout.connect(check)
        timer.start()
    
