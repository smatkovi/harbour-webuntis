    @Slot(int)
    def getPeriodData(self, periodId):
        """Get detailed period data with students and absences"""
        def worker():
            try:
                self._log(u"getPeriodData2017 for period %d" % periodId)
                result = self._mobile_call("getPeriodData2017", {"ttIds": [periodId]})
                
                if "error" in result:
                    self._period_result = json.dumps({'error': result.get('error', {}).get('message', 'Fehler')})
                    return
                
                if "result" not in result:
                    self._period_result = json.dumps({'error': 'Keine Daten'})
                    return
                
                data = result["result"]
                data_by_tt = data.get("dataByTTId", {})
                period_data = data_by_tt.get(str(periodId), {})
                
                # Students
                students = []
                for s in data.get("referencedStudents", []):
                    students.append({
                        'studId': s.get('id'),
                        'firstName': s.get('foreName', s.get('firstName', '')),
                        'lastName': s.get('longName', s.get('lastName', '')),
                        'className': s.get('className', ''),
                        'imageUrl': s.get('imageUrl', ''),
                    })
                
                if not students:
                    for s in period_data.get("students", []):
                        students.append({
                            'studId': s.get('id'),
                            'firstName': s.get('firstName', ''),
                            'lastName': s.get('lastName', ''),
                            'className': s.get('className', ''),
                            'imageUrl': s.get('imageUrl', ''),
                        })
                
                students.sort(key=lambda x: (x.get('lastName', ''), x.get('firstName', '')))
                
                # Absences
                absences = []
                for a in (period_data.get("absences") or []):
                    absences.append({
                        'id': a.get('id'),
                        'studentId': a.get('studentId'),
                        'reasonId': a.get('reasonId'),
