    @Slot(int, result=unicode)
    def getAvatarPath(self, studentId):
        """Get local path for avatar if it exists"""
        ensure_avatar_dir()
        path = os.path.join(AVATAR_CACHE_DIR, "%d.jpg" % studentId)
        if os.path.exists(path):
            return "file://" + path
        return ""
    
    @Slot(int, unicode)
    def fetchAvatar(self, studentId, imageUrl):
        """Download and cache avatar image for next time"""
        if not imageUrl or studentId in self._avatar_loading:
            return
        
        # Check if already cached
        ensure_avatar_dir()
        local_path = os.path.join(AVATAR_CACHE_DIR, "%d.jpg" % studentId)
        if os.path.exists(local_path):
            return  # Already have it
        
        # Limit concurrent downloads to 1
        if len(self._avatar_loading) >= 1:
            # Queue for later
            self._retry_fetch_avatar(studentId, imageUrl)
            return
        
        self._avatar_loading.add(studentId)
        self._log(u"Fetching avatar for student %d" % studentId)
        
        def worker():
            try:
                # Build full URL if relative
                if imageUrl.startswith('/'):
                    url = "https://%s%s" % (self._server, imageUrl)
                elif not imageUrl.startswith('http'):
                    url = "https://%s/WebUntis/%s" % (self._server, imageUrl)
                else:
                    url = imageUrl
                
                # Download image using image_helper
                image_helper = "/opt/webuntis/image_helper.py"
                cmd = [image_helper, url, local_path]
                
                proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
                out, err = proc.communicate()
                
                if proc.returncode == 0 and os.path.exists(local_path):
                    self._log(u"Avatar saved: %d" % studentId)
                    
            except Exception as e:
                self._log(u"Avatar error: %s" % unicode(e))
            finally:
                self._avatar_loading.discard(studentId)
        
        t = threading.Thread(target=worker)
        t.daemon = True
        t.start()


