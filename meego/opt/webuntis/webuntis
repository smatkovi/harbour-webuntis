    @Slot(unicode, unicode)
    def getTimetable(self, startDate, endDate):
        """Get own timetable using Legacy JSON-RPC API (like Sailfish app)"""
        type_map = {"CLASS": 1, "TEACHER": 2, "SUBJECT": 3, "ROOM": 4, "STUDENT": 5}
        elem_type = type_map.get(self._user_type, 2)
        self._get_timetable_jsonrpc(elem_type, self._user_id, startDate, endDate)
    
    @Slot(unicode, int, unicode, unicode)
    def getTimetableFor(self, entityType, entityId, startDate, endDate):
        """Get timetable for specific entity (class/teacher/room)"""
        self._log(u"getTimetableFor called: type=%s, id=%s, %s-%s" % (entityType, entityId, startDate, endDate))
        type_map = {"CLASS": 1, "TEACHER": 2, "SUBJECT": 3, "ROOM": 4, "STUDENT": 5}
        elem_type = type_map.get(unicode(entityType).upper(), 1)
        self._log(u"Mapped to elem_type=%d" % elem_type)
        self._get_timetable_jsonrpc(elem_type, int(entityId), startDate, endDate)
    
    def _get_timetable_jsonrpc(self, elem_type, elem_id, startDate, endDate):
        """Get timetable using standard jsonrpc.do API (this works!)"""
        def worker():
            try:
                # Convert YYYY-MM-DD to integer YYYYMMDD
                start_int = int(startDate.replace("-", ""))
                end_int = int(endDate.replace("-", ""))
                
                self._log(u"jsonrpc.do getTimetable: type=%d, id=%s, %d-%d" % (elem_type, elem_id, start_int, end_int))
                
                # Use standard JSON-RPC API (not mobile API)
                url = "https://%s/WebUntis/jsonrpc.do?school=%s" % (self._server, self._school)
                
                payload = {
                    "id": "1",
                    "method": "getTimetable",
                    "params": {
                        "startDate": start_int,
                        "endDate": end_int,
                        "id": elem_id,
                        "type": elem_type
                    },
                    "jsonrpc": "2.0"
                }
                
                result = self._http_request("POST", url, payload, {"Content-Type": "application/json"})
                
                self._log(u"jsonrpc.do result keys: %s" % unicode(result.keys() if isinstance(result, dict) else type(result).__name__))
                
                if "error" in result:
                    error_msg = result.get('error', {})
                    if isinstance(error_msg, dict):
                        error_msg = error_msg.get('message', unicode(error_msg))
                    self._log(u"getTimetable error: %s" % error_msg)
                    self._timetable_result = json.dumps({'error': unicode(error_msg)})
                    return
                
                periods_raw = result.get("result", [])
                self._log(u"Found %d periods" % len(periods_raw))
                
                if periods_raw and len(periods_raw) > 0:
                    self._log(u"First period: %s" % unicode(periods_raw[0])[:300])
                
                # Convert to our format
                lessons = []
                for p in periods_raw:
                    if not isinstance(p, dict):
                        continue
                    
                    lstype = p.get('lstype', '')
                    
                    # Determine activity type
                    if lstype == 'bs':
                        activity = 'Bereitschaft'
                    elif lstype == 'oh':
                        activity = 'Gangaufsicht'
                    else:
                        activity = p.get('activityType', 'Unterricht')
                    
                    # Extract names from cache
                    classes = []
                    for k in p.get('kl', []):
                        if isinstance(k, dict):
                            classes.append(self._cache['classes'].get(k.get('id'), 'K%s' % k.get('id')))
                    
                    subjects = []
                    for s in p.get('su', []):
                        if isinstance(s, dict):
                            subjects.append(self._cache['subjects'].get(s.get('id'), 'S%s' % s.get('id')))
                    
                    teachers = []
                    for t in p.get('te', []):
                        if isinstance(t, dict):
                            teachers.append(self._cache['teachers'].get(t.get('id'), 'T%s' % t.get('id')))
                    
                    rooms = []
                    for r in p.get('ro', []):
                        if isinstance(r, dict):
                            rooms.append(self._cache['rooms'].get(r.get('id'), 'R%s' % r.get('id')))
                    
                    # Use activity as subject if no subjects
                    if not subjects and lstype:
                        subjects = [activity]
                    
                    lesson = {
                        'id': p.get('id'),
                        'date': p.get('date'),
                        'startTime': p.get('startTime'),
                        'endTime': p.get('endTime'),
                        'classes': classes,
                        'subjects': subjects,
                        'teachers': teachers,
                        'rooms': rooms,
                        'code': p.get('code', ''),
                        'cellState': p.get('cellState', 'STANDARD'),
                        'activityType': activity,
                        'lstype': lstype,
                        'text': p.get('lstext', '')
                    }
                    lessons.append(lesson)
                
                # Sort by date and time
                lessons.sort(key=lambda l: (l.get('date', 0), l.get('startTime', 0)))
                self._log(u"Parsed %d lessons" % len(lessons))
                
                self._timetable_result = json.dumps({'lessons': lessons})
                
            except Exception as e:
                import traceback
                self._log(u"Timetable ERROR: %s" % unicode(e))
                self._log(u"Traceback: %s" % traceback.format_exc())
                self._timetable_result = json.dumps({'error': unicode(e)})
        
        self._timetable_result = None
        t = threading.Thread(target=worker)
        t.start()
        self._async_check(t, '_timetable_result', self.timetableReady)
    
