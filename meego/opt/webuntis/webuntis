    @Slot(result=bool)
    def autoLogin(self):
        if not self._load_credentials():
            return False
        
        self._log(u"Auto-login: %s @ %s" % (self._username, self._server))
        
        result = self._mobile_call("getUserData2017")
        
        if "error" not in result and "result" in result:
            self._process_user_data(result["result"])
            self._logged_in = True
            self.loginSuccess.emit(self._username)
            return True
        
        return False
    
    # Mindestlaenge: mit 2 Zeichen antwortet die Schulsuche fast immer mit
    # -6003 ("too many results"), das sah nach einem Fehler aus.
    MIN_SCHOOL_QUERY = 3

    # Fehlercodes der Schulsuche in Klartext
    SEARCH_ERRORS = {
        -6003: u"Zu viele Treffer - bitte genauer eingeben",
    }

    @Slot(unicode)
    def searchSchools(self, query):
        def worker():
            try:
                url = "https://schoolsearch.webuntis.com/schoolquery2"
                payload = {
                    "id": "wu_schulsuche-%d" % int(time.time()),
                    "method": "searchSchool",
                    "params": [{"search": query}],
                    "jsonrpc": "2.0"
                }
                
                result = self._http_request("POST", url, payload, {"Content-Type": "application/json"})
                
                error = result.get("error") if isinstance(result, dict) else None
                if error:
                    code = error.get("code")
                    message = self.SEARCH_ERRORS.get(code) or error.get("message") or u"Unbekannter Fehler"
                    self._log(u"Schulsuche '%s': Fehler %s (%s)" % (query, code, error.get("message")))
                    self._search_result = json.dumps({'error': message})
                    return
                
                schools = (result.get("result") or {}).get("schools") or []
                self._log(u"Schulsuche '%s': %d Ergebnisse" % (query, len(schools)))
                formatted = []
                for s in schools[:20]:
                    server = s.get('server', '')
                    login_name = s.get('loginName', '')
                    if not server or not login_name:
                        continue
                    formatted.append({
                        'displayName': s.get('displayName', '') or login_name,
                        'address': s.get('address', ''),
                        'server': server,
                        'loginName': login_name
                    })
                self._search_result = json.dumps({'schools': formatted})
            except Exception as e:
                self._search_result = json.dumps({'error': u'Schulsuche nicht erreichbar: %s' % unicode(e)})
        
        query = (query or u"").strip()
        if len(query) < self.MIN_SCHOOL_QUERY:
            self._search_result = json.dumps(
                {'error': u'Suchbegriff zu kurz (min. %d Zeichen)' % self.MIN_SCHOOL_QUERY})
            self.schoolsFound.emit(self._search_result)
            return
        
        self._search_result = None
        t = threading.Thread(target=worker)
        t.start()
        self._async_check(t, '_search_result', self.schoolsFound)
    
    @Slot(unicode, unicode, result=unicode)
    def parseSchoolUrl(self, text, loginName):
        """
        Server und Schulkennung aus einer von Hand eingetippten WebUntis-Adresse
        holen - der Rueckfall, wenn die Schulsuche nichts findet.
        Versteht z.B.
          https://melpomene.webuntis.com/WebUntis/?school=meineschule
          melpomene.webuntis.com/WebUntis/index.do#/basic/login?school=abc
          melpomene.webuntis.com            (dann muss loginName dabei sein)
        """
        text = (text or u"").strip()
        login_name = (loginName or u"").strip()
        
        if not text:
            return json.dumps({'error': u'Bitte die WebUntis-Adresse eintragen'})
        
        raw = text if '//' in text else u'https://' + text
        try:
            server = (urlparse.urlsplit(raw).hostname or u'').strip().lower()
        except Exception:
            server = u''
        
        if not server or '.' not in server:
            return json.dumps({'error': u'Das sieht nicht nach einer Adresse aus (z.B. xyz.webuntis.com)'})
        
        if not login_name:
            found = re.search(r'school=([^&#/?]+)', raw, re.IGNORECASE)
            if found:
                login_name = urlparse.unquote(found.group(1)).strip()
        
        if not login_name:
            return json.dumps({'error': u'Schulkennung fehlt - sie steht in der Adresse als school=...'})
        
        self.setSchool(server, login_name)
        return json.dumps({'server': server, 'loginName': login_name})
    
    @Slot(unicode, unicode)
