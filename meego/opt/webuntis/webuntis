    @Slot(int, unicode, int, unicode, unicode)
    def submitClassRegEvent(self, periodId, elementIds, reasonId, text, elementType):
        """Submit class register event"""
        def worker():
            try:
                # Parse element IDs
                ids = [int(x.strip()) for x in elementIds.split(',') if x.strip()]
                if not ids:
                    self._op_result = json.dumps({'success': False, 'error': 'Keine Elemente ausgewählt'})
                    return
                
                if not text or not text.strip():
                    self._op_result = json.dumps({'success': False, 'error': 'Bitte Text eingeben'})
                    return
                
                type_map = {"STUDENT": 5, "CLASS": 1, "KLASSE": 1, "TEACHER": 2}
                elem_type_num = type_map.get(elementType.upper(), 5)
                reason_val = reasonId if reasonId and reasonId > 0 else -1
                
                now = datetime.now()
                date_str = now.strftime("%Y-%m-%d")
                time_str = now.strftime("%H:%M")
                
                success_count = 0
                for elem_id in ids:
                    params = {
                        "ttId": periodId,
                        "event": {
                            "id": 0,
                            "date": date_str,
                            "startTime": time_str,
                            "text": text.strip(),
                            "reasonId": reason_val,
                            "element": {"type": elem_type_num, "id": elem_id}
                        }
                    }
                    
                    result = self._mobile_call("submitClassRegEvents", params)
                    if "error" not in result:
                        success_count += 1
                
                if success_count > 0:
                    self._op_result = json.dumps({'success': True, 'count': success_count})
                else:
                    self._op_result = json.dumps({'success': False, 'error': 'Eintrag konnte nicht erstellt werden'})
                    
            except Exception as e:
                self._op_result = json.dumps({'success': False, 'error': unicode(e)})
        
        self._op_result = None
        t = threading.Thread(target=worker)
        t.start()
        self._async_check(t, '_op_result', self.operationResult)
    
