    def _http_request(self, method, url, data=None, headers=None, timeout=30):
        """HTTP request via Python 3.11 helper"""
        try:
            data_str = json.dumps(data) if data else ""
            headers_str = json.dumps(headers) if headers else "{}"
            
            cmd = [HTTP_HELPER, method, url, data_str, headers_str, str(timeout)]
            env = os.environ.copy()
            env['PYTHONIOENCODING'] = 'utf-8'
            
            proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, env=env)
            out, err = proc.communicate()
            
            if isinstance(out, str):
                out = out.decode('utf-8')
            
            return json.loads(out)
        except Exception as e:
            self._log(u"HTTP error: %s" % unicode(e))
            return {'error': unicode(e)}
    
    def _mobile_call(self, method, extra_params=None):
        """Call WebUntis Mobile API (jsonrpc_intern.do) with TOTP auth"""
        if not self._secret or not self._username:
            return {'error': {'message': 'Nicht authentifiziert'}}
        
        otp = generate_otp(self._secret)
        client_time = int(time.time() * 1000)
        
        params = {
            "auth": {
                "user": self._username,
                "otp": int(otp),
                "clientTime": client_time
            }
        }
        
        if extra_params:
            params.update(extra_params)
        
        payload = {
            "id": "1",
            "method": method,
            "params": [params],
            "jsonrpc": "2.0"
        }
        
        url = "https://%s/WebUntis/jsonrpc_intern.do?school=%s" % (self._server, self._school)
        return self._http_request("POST", url, payload, {"Content-Type": "application/json"})
    
    def _jsonrpc_call(self, method, params):
        """Call standard WebUntis API (jsonrpc.do) - for timetable"""
        payload = {
            "id": "1",
            "method": method,
            "params": params,
            "jsonrpc": "2.0"
        }
        
        url = "https://%s/WebUntis/jsonrpc.do?school=%s" % (self._server, self._school)
        return self._http_request("POST", url, payload, {"Content-Type": "application/json"})
    
    # ==================== Credentials ====================
    
    def _save_credentials(self):
        try:
            ensure_config_dir()
            data = {
                'server': self._server,
                'school': self._school,
                'username': self._username,
                'secret': self._secret
            }
            with open(CREDENTIALS_FILE, 'w') as f:
                json.dump(data, f)
            self._log(u"Credentials saved")
            return True
        except Exception as e:
            self._log(u"Save credentials error: %s" % e)
            return False
    
    def _load_credentials(self):
        try:
            if os.path.exists(CREDENTIALS_FILE):
                with open(CREDENTIALS_FILE, 'r') as f:
                    data = json.load(f)
                self._server = data.get('server', '')
                self._school = data.get('school', '')
                self._username = data.get('username', '')
                self._secret = data.get('secret', '')
                return bool(self._server and self._school and self._username and self._secret)
        except Exception as e:
            self._log(u"Load credentials error: %s" % e)
        return False
    
    def _delete_credentials(self):
        try:
            if os.path.exists(CREDENTIALS_FILE):
                os.remove(CREDENTIALS_FILE)
        except:
            pass
    
    def _process_user_data(self, user_data):
        """Process getUserData2017 and populate cache"""
        inner = user_data.get("userData", {})
        if inner:
            self._user_id = inner.get("elemId")
            elem_type = inner.get("elemType", "TEACHER")
            
            if isinstance(elem_type, (str, unicode)):
                self._user_type = elem_type.upper()
            else:
                type_map = {1: "CLASS", 2: "TEACHER", 3: "SUBJECT", 4: "ROOM", 5: "STUDENT"}
                self._user_type = type_map.get(elem_type, "TEACHER")
        
        self._log(u"User: ID=%s, Type=%s" % (self._user_id, self._user_type))
        
        master_data = user_data.get("masterData", {})
        
        # Teachers
        for t in master_data.get("teachers", []):
            self._cache['teachers'][t['id']] = t.get('name', t.get('longName', '?'))
        
        # Subjects
        for s in master_data.get("subjects", []):
            self._cache['subjects'][s['id']] = s.get('name', s.get('longName', '?'))
        
        # Rooms
        for r in master_data.get("rooms", []):
            self._cache['rooms'][r['id']] = r.get('name', r.get('longName', '?'))
        
        # Classes (klassen)
        for k in master_data.get("klassen", []):
            self._cache['classes'][k['id']] = k.get('name', '?')
        
        # Absence reasons
        self._cache['absence_reasons'] = master_data.get("absenceReasons", [])
        self._cache['event_reasons'] = master_data.get("eventReasons", [])
        self._cache['default_absence_reason_id'] = master_data.get("defaultAbsenceReasonId")
        self._cache['default_lateness_reason_id'] = master_data.get("defaultLatenessReasonId")
        
        self._log(u"Cache: %d teachers, %d classes, %d subjects, %d absence reasons" % 
                  (len(self._cache['teachers']), len(self._cache['classes']), 
                   len(self._cache['subjects']), len(self._cache['absence_reasons'])))
    
