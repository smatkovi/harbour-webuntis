    @Slot(int, int, int, unicode)
    def createAbsence(self, periodId, studentId, reasonId, text):
        """Create absence using createAbsences2017 (like Sailfish app)"""
        def worker():
            try:
                # Validate reason
                valid_reasons = [r.get('id') for r in self._cache.get('absence_reasons', []) if r.get('id')]
                if not reasonId or reasonId not in valid_reasons:
                    if 2 in valid_reasons:
                        reason = 2
                    elif self._cache.get('default_absence_reason_id'):
                        reason = self._cache.get('default_absence_reason_id')
                    elif valid_reasons:
                        reason = valid_reasons[0]
                    else:
                        reason = 2
                else:
                    reason = reasonId
                
                # Get period times first
                period_check = self._mobile_call("getPeriodData2017", {"ttIds": [periodId]})
                if "error" in period_check or "result" not in period_check:
                    self._op_result = json.dumps({'success': False, 'error': 'Periode nicht gefunden'})
                    return
                
                data = period_check["result"]
                period_data = data.get("dataByTTId", {}).get(str(periodId), {})
                topic = period_data.get("topic", {}) or {}
                start_dt = topic.get("startDateTime", "")
                end_dt = topic.get("endDateTime", "")
                
                if not start_dt or not end_dt:
                    self._op_result = json.dumps({'success': False, 'error': 'Stundenzeiten nicht verfügbar'})
                    return
                
                params = {
                    "periodId": periodId,
                    "studentIds": [studentId],
                    "absenceReasonId": reason,
                    "startDateTime": start_dt,
                    "endDateTime": end_dt
                }
                if text and text.strip():
                    params["text"] = text.strip()
                
                result = self._mobile_call("createAbsences2017", params)
                
                if "error" in result:
                    self._op_result = json.dumps({'success': False, 'error': result['error'].get('message', 'Fehler')})
                else:
                    self._op_result = json.dumps({'success': True})
                    
            except Exception as e:
                self._op_result = json.dumps({'success': False, 'error': unicode(e)})
        
        self._op_result = None
        t = threading.Thread(target=worker)
        t.start()
        self._async_check(t, '_op_result', self.operationResult)
    
