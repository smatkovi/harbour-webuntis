    @Slot(unicode, unicode, bool)
    def login(self, username, secret, save):
        def worker():
            self._username = username
            self._secret = secret
            
            self._log(u"Login attempt: %s" % username)
            
            result = self._mobile_call("getUserData2017")
            
            if "error" in result:
                error_msg = result.get("error", {}).get("message", "Login fehlgeschlagen")
                self._login_result = json.dumps({'success': False, 'error': error_msg})
                return
            
            if "result" not in result:
                self._login_result = json.dumps({'success': False, 'error': 'Keine Daten erhalten'})
                return
            
            self._process_user_data(result["result"])
            self._logged_in = True
            
            if save:
                self._save_credentials()
            
            self._login_result = json.dumps({'success': True})
        
        self._login_result = None
        t = threading.Thread(target=worker)
        t.start()
        
        # Wieder ohne singleShot - siehe _async_check
        if self._async_timers is None:
            self._async_timers = []

        timer = QTimer(self)
        timer.setInterval(100)
        keep = []

        def finish(error):
            timer.stop()
            try:
                self._async_timers.remove(keep)
            except ValueError:
                pass
            if error:
                self.loginFailed.emit(error)
            else:
                self.loginSuccess.emit(self._username)

        def check():
            if self._login_result:
                result = json.loads(self._login_result)
                if result.get('success'):
                    finish(None)
                else:
                    finish(result.get('error', u'Login fehlgeschlagen'))
            elif not t.is_alive():
                finish(u"Zeitüberschreitung")

        keep.extend([timer, check, finish])
        self._async_timers.append(keep)
        timer.timeout.connect(check)
        timer.start()
    
